{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samawi-dating",
  "main": "src/main.py",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "dating.samawi.co.uk",
      "custom_domain": true
    }
  ],
  "r2_buckets": [{"binding":"PHOTOS","bucket_name":"samawi-dating-photos"}],
  "r2_buckets": [
    {"binding": "PHOTOS", "bucket_name": "samawi-dating-photos"}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samawi-dating",
      "database_id": "5c19722d-e447-46f8-a41f-410e9767bcf2"
    }
  ]
}
